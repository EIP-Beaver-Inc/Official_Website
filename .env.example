# Copy to .env (never commit .env). Read by docker compose for the backend.

# --- Database / site ---
MONGO_URL=mongodb://mongo:27017
DB_NAME=beaver_db
# Explicit origins (comma-separated). Avoid "*" in production.
CORS_ORIGINS=https://beaver-website.fr,https://www.beaver-website.fr
ADMIN_TOKEN=

# --- Email notifications (contact / quote forms) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=beaver.eip@gmail.com

# --- BETA software licenses (docs/beta-keys.md) ---
# Mandatory: without them the feature is disabled (/api/beta/validate etc. answer 503).
# Generate with: docker compose exec backend bin/beta-crypto gen-pepper | gen-signing-key | gen-model-key --id beta-1
BETA_KEY_PEPPER=
BETA_SIGNING_PRIVATE_KEY=
BETA_SIGNING_KID=
# JSON object {"<model_key_id>": "<base64 of 32 bytes>"}, e.g. {"beta-1":"..."}
BETA_MODEL_KEYS=

# Optional (defaults shown)
BETA_DURATION_DAYS=14
BETA_REDEEM_WINDOW_DAYS=30
BETA_MAX_MACHINES=2
BETA_MAX_DOWNLOADS=5
BETA_CHECK_INTERVAL_SECONDS=900
BETA_DOWNLOAD_URL_TTL_SECONDS=600
# Base of the download links returned by /api/beta/download (default: derived from the request).
BETA_PUBLIC_BASE_URL=https://beaver-website.fr
